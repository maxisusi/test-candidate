{
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "hostRequirements": {
    "cpus": 4
  },
  "waitFor": "onCreateCommand",
  "onCreateCommand": "sudo apt-get update && sudo apt-get install -y just",
  "updateContentCommand": "npm install",
  "postCreateCommand": "",
  "postAttachCommand": {
    "server": "just start"
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "src/App.tsx"
      ]
    }
  },
  "portsAttributes": {
    "3000": {
      "label": "Application",
      "onAutoForward": "openPreview"
    },
    "8000": {
      "label": "Symfony Backend",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [3000, 8000]
}
